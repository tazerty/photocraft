<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Lumbra: third-party Rust licenses</title>
<style>
  body { font: 14px/1.5 system-ui, sans-serif; max-width: 860px; margin: 0 auto; padding: 16px; }
  pre { white-space: pre-wrap; background: #f4f4f5; padding: 12px; }
  @media (prefers-color-scheme: dark) { body { background: #18181b; color: #e4e4e7; } pre { background: #27272a; } }
</style>
</head>
<body>
<h1>Third-party Rust licenses</h1>
<p>Licenses of the Rust crates compiled into this Lumbra web build (Evora fork of PhotoCraft),
generated by cargo-about. See also LICENSE-MIT, LICENSE-APACHE, NOTICE, ATTRIBUTION.md and
MENTIONS.txt in this folder.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}</ul>
<h2>License texts</h2>
{{#each licenses}}
<section>
{{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
<p>Used by:</p>
<ul>
{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>
{{/each}}</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
